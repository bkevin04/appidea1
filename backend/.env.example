# Copy to .env and fill in. Without an API key the server runs in offline "mock" mode.
ANTHROPIC_API_KEY=

# "anthropic" or "mock". Defaults to anthropic when ANTHROPIC_API_KEY is set, otherwise mock.
LLM_PROVIDER=

# Model and thinking effort used to turn document sections into games.
CLAUDE_MODEL=claude-opus-5-5
GENERATION_EFFORT=medium
GRADING_EFFORT=low

PORT=3000
DATABASE_PATH=./data/app.db

# How many units to generate ahead of the learner (keeps cost down for long books).
GENERATE_AHEAD=2
# Challenges per daily session.
SESSION_SIZE=8
DAILY_XP_GOAL=50
